# Copy this file to .env and fill in the values.
#   cp .env.example .env
# .env is git-ignored. Never commit real keys.

# Port the HTTP service listens on (default 3000).
PORT=3000

# --- Gemini AI ---
# From https://aistudio.google.com/apikey. Server-only. (required, SECRET, never commit or expose to the browser)
GEMINI_API_KEY=
# Optional model override. (optional)
GEMINI_MODEL=gemini-flash-latest

# --- Internet-Native Payments (x402 V2, Solana devnet) ---
# Your Solana devnet wallet address. Payments to your paid endpoints arrive here. (required)
PAY_TO_ADDRESS=
# CAIP-2 id. Only Solana devnet is allowed by this template. (optional)
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
# Free public test facilitator: verifies + settles devnet payments and pays the SOL fees. (optional)
X402_FACILITATOR_URL=https://x402.org/facilitator
# DEVNET-ONLY throwaway key for the paying side (buyer). Base58 or solana-keygen JSON array. Never commit. (optional, SECRET, never commit or expose to the browser)
AGENT_PRIVATE_KEY=
# Optional devnet RPC used when building payments. (optional)
SOLANA_RPC_URL=https://api.devnet.solana.com

# --- AI Race adapter ---
# From your team page on Agent Studio. Only the race verifier sends it. (required, SECRET, never commit or expose to the browser)
AGENT_STUDIO_VERIFIER_TOKEN=
# Name shown in the health response. (optional)
AGENT_STUDIO_APP_NAME=my-race-agent
# For the Memory layer on serverless hosting: keeps conversation history between requests. Free Upstash Redis database; Vercel's Upstash integration sets KV_REST_API_URL instead, which also works. (optional)
UPSTASH_REDIS_REST_URL=
# The REST token for that database (or KV_REST_API_TOKEN from Vercel's integration). (optional, SECRET, never commit or expose to the browser)
UPSTASH_REDIS_REST_TOKEN=

# --- Spending Controls ---
# Total the agent may spend before it restarts. Default 1.00. (optional)
AGENT_BUDGET_USD=1.00
# Largest single payment allowed. Default 0.10. (optional)
MAX_PAYMENT_USD=0.10

# --- Paid API Example ---
# Price per request in (devnet) USDC. Default 0.01. (optional)
PAID_API_PRICE_USD=0.01

# --- Pay.sh ---
# Your deployed https:// address, used in the Pay.sh catalog listing. Leave empty while you build locally. (optional)
PAYSH_SERVICE_URL=

# Which model answers. Claude when ANTHROPIC_API_KEY is set, otherwise Gemini. LLM_PROVIDER=claude or gemini forces a choice.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# MediPass. Devnet addresses that receive the pharmacy and doctor payments. Empty means the payment is shown as simulated.
MEDIPASS_PHARMACY_ADDRESS=
MEDIPASS_DOCTOR_ADDRESS=
# Signs the pharmacy codes. Falls back to AGENT_STUDIO_VERIFIER_TOKEN.
MEDIPASS_SECRET=
